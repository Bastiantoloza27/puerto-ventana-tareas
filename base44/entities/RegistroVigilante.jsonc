{
  "name": "RegistroVigilante",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "puesto": {
      "type": "string"
    },
    "tarea_id": {
      "type": "string"
    },
    "mensual": {
      "type": "boolean",
      "description": "Tarea peri\u00f3dica: basta una vez en el mes por turno"
    },
    "estado": {
      "type": "string",
      "enum": [
        "ok",
        "no"
      ],
      "enumColors": [
        "green",
        "red"
      ]
    },
    "motivo": {
      "type": "string",
      "description": "Motivo si no se ejecut\u00f3"
    },
    "observaciones": {
      "type": "string"
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "is_img": {
            "type": "boolean"
          }
        }
      }
    },
    "vigilante": {
      "type": "string"
    },
    "hora": {
      "type": "string"
    }
  },
  "required": [
    "fecha",
    "turno",
    "puesto",
    "tarea_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "vigilante"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "vigilante"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "vigilante"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
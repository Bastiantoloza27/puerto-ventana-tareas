{
  "name": "ActaReunion",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "hora": {
      "type": "string"
    },
    "lugar": {
      "type": "string"
    },
    "participantes": {
      "type": "string"
    },
    "desarrollo": {
      "type": "string",
      "description": "Temas tratados"
    },
    "acuerdos": {
      "type": "string",
      "description": "Acuerdos y compromisos"
    },
    "adjuntos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "is_img": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "titulo",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
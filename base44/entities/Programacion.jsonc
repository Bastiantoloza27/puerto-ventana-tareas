{
  "name": "Programacion",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "asesor": {
      "type": "string"
    },
    "actividad_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "borrador",
        "publicada",
        "cerrada"
      ],
      "default": "borrador"
    },
    "publicada_hora": {
      "type": "string"
    },
    "cerrada_hora": {
      "type": "string"
    },
    "entrega": {
      "type": "string"
    },
    "envio_hora": {
      "type": "string",
      "description": "Momento (ISO) en que se enviar\u00e1 el correo de tareas al asesor: inicio del turno"
    },
    "envio_estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "enviado",
        "error"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    },
    "envio_cc": {
      "type": "string",
      "description": "Correo de quien public\u00f3, recibe copia"
    },
    "faenas": {
      "type": "array",
      "description": "Faenas del turno seg\u00fan la nombrada de Operaciones (solo cargos clave y conteos)",
      "items": {
        "type": "object",
        "properties": {
          "faena": {
            "type": "string"
          },
          "nave": {
            "type": "string"
          },
          "sitio": {
            "type": "string"
          },
          "jefe_nave": {
            "type": "string"
          },
          "supervisor": {
            "type": "string"
          },
          "capataces": {
            "type": "string"
          },
          "dotacion": {
            "type": "number"
          },
          "cargos": {
            "type": "object",
            "additionalProperties": true
          },
          "actividad_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dotacion": {
      "type": "number",
      "description": "Personas en el turno seg\u00fan la nombrada"
    },
    "correo": {
      "type": "object",
      "properties": {
        "asunto": {
          "type": "string"
        },
        "hora": {
          "type": "string"
        },
        "lineas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "texto": {
                "type": "string"
              },
              "actividad_id": {
                "type": "string"
              }
            }
          }
        },
        "envios": {
          "type": "array",
          "description": "Cada correo de Operaciones recibido para este turno, en orden",
          "items": {
            "type": "object",
            "properties": {
              "n": {
                "type": "number"
              },
              "asunto": {
                "type": "string"
              },
              "hora": {
                "type": "string"
              },
              "remitente": {
                "type": "string"
              },
              "lineas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "texto": {
                      "type": "string"
                    },
                    "actividad_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "actualizacion": {
          "type": "object",
          "properties": {
            "hora": {
              "type": "string"
            },
            "texto": {
              "type": "string"
            },
            "actividad_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "bitacora": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hora": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          }
        }
      }
    },
    "r_prog": {
      "type": "number"
    },
    "r_ok": {
      "type": "number"
    },
    "r_no": {
      "type": "number"
    },
    "r_na": {
      "type": "number"
    },
    "r_pct": {
      "type": "number"
    },
    "r_novs": {
      "type": "number"
    },
    "r_motivos": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "fecha",
    "turno"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "asesor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "asesor"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
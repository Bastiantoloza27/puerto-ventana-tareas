{
  "name": "EventoCoordinador",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "reunion",
        "actividad",
        "capacitacion",
        "gestion",
        "recordatorio"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "purple",
        "gray"
      ]
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "hora_inicio": {
      "type": "string"
    },
    "hora_fin": {
      "type": "string"
    },
    "lugar": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "completado"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pendiente"
    }
  },
  "required": [
    "titulo",
    "fecha"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
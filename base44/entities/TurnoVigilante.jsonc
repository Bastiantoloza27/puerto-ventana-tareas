{
  "name": "TurnoVigilante",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "puesto": {
      "type": "string"
    },
    "tarea_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uso anterior: ajuste de tareas de la matriz (ya no se usa)"
    },
    "manuales": {
      "type": "array",
      "description": "Tareas manuales agregadas por Jefatura para este turno y puesto, adem\u00e1s de las fijas",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tarea": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "fecha",
    "turno",
    "puesto"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.perfil": "vigilante"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
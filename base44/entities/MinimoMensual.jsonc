{
  "name": "MinimoMensual",
  "type": "object",
  "properties": {
    "mes": {
      "type": "string"
    },
    "asesor": {
      "type": "string"
    },
    "charlas": {
      "type": "number",
      "default": 0
    },
    "conducta": {
      "type": "number",
      "default": 0
    },
    "inspeccion": {
      "type": "number",
      "default": 0
    },
    "epp": {
      "type": "number",
      "default": 0
    },
    "cuasi": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "mes",
    "asesor"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Integrante",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "cargo": {
      "type": "string"
    },
    "perfil": {
      "type": "string",
      "enum": [
        "jefatura",
        "asesor"
      ],
      "enumColors": [
        "purple",
        "blue"
      ]
    }
  },
  "required": [
    "nombre",
    "email",
    "perfil"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}